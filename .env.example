# Supabase Project > Connect / API Keys. Copy to .env.local for development.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key belongs ONLY in server/hosting environment settings. Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Exact public website origin, with HTTPS in production.
APP_ORIGIN=https://yetişikayet.com
# Optional random server-only HMAC salt; defaults to the Supabase secret key.
RATE_LIMIT_SALT=
# Enable only if the trusted proxy replaces incoming X-Forwarded-For.
TRUST_PROXY=0
PUBLIC_INDEXING_ENABLED=false
